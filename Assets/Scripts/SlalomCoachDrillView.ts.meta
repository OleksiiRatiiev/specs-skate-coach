  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">SlalomCoachDrillView - one copy of the drill</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input bool isGhost {"hint":"Faint copy shown while choosing where to place the drill"}'
    - '// @input float ghostStrength = 0.4 {"hint":"Brightness of the ghost compared with the placed drill", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - '// @input float coneHeightCm = 30 {"hint":"Cone height in cm", "widget":"slider", "min":10, "max":60, "step":1}'
    - '// @input float coneRadiusCm = 10 {"hint":"Cone base radius in cm", "widget":"slider", "min":4, "max":20, "step":1}'
    - '// @input float poleHeightCm = 100 {"hint":"Marker pole height above the floor in cm", "widget":"slider", "min":50, "max":150, "step":5}'
    - '// @input float poleThicknessCm = 2 {"hint":"Marker pole thickness in cm", "widget":"slider", "min":1, "max":6, "step":0.5}'
    - '// @input float highlightThicknessFactor = 2 {"hint":"How many times thicker the highlighted next pole is than the others", "widget":"slider", "min":1, "max":4, "step":0.5}'
    - '// @input float finishBandDepthCm = 30 {"hint":"Depth of the finish band along the drill, in cm", "widget":"slider", "min":10, "max":60, "step":1}'
    - '// @input float pathWidthCm = 10 {"hint":"Width of the glowing path line in cm", "widget":"slider", "min":4, "max":30, "step":1}'
    - '// @input vec3 coneColor = "{0.72,0.82,0.95}" {"hint":"Cone colour before and after a clean pass. Keep it clearly different from the miss colour", "widget":"color"}'
    - '// @input vec3 coneMissedColor = "{1,0.62,0.05}" {"hint":"Cone colour after a miss", "widget":"color"}'
    - '// @input vec3 poleColor = "{0.12,0.38,0.46}" {"hint":"Pole colour when it is not the next cone", "widget":"color"}'
    - '// @input vec3 poleHighlightColor = "{0.85,1,1}" {"hint":"Pole colour when it is the next cone. Much brighter than the others", "widget":"color"}'
    - '// @input vec3 pathColor = "{0.15,0.75,0.8}" {"hint":"Path line colour at rest", "widget":"color"}'
    - '// @input vec3 pathBrightColor = "{0.75,1,1}" {"hint":"Path line colour when it brightens because the skater drifted away", "widget":"color"}'
    - '// @input vec3 padColor = "{0.3,0.7,0.75}" {"hint":"Start pad colour", "widget":"color"}'
    - '// @input vec3 finishColor = "{1,1,0.95}" {"hint":"Finish band colour. Bright and wide so it reads from a distance", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
